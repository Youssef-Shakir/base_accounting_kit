<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Financial report trees (DoniaLink fixes, 18.0.5.1.0).
         noupdate="0": the standard trees are kept up to date by module upgrades; create your
         own report trees for custom layouts. Every line selects accounts by account type, so
         renaming or translating a line never changes the figures.
         Display sign: '-1' shows credit balances (income, liabilities, equity) as positive. -->
    <data noupdate="0">

        <!-- ================= Profit and Loss ================= -->
        <record id="account_financial_report_profitandloss0" model="account.financial.report">
            <field name="name">Profit and Loss</field>
            <field name="sign">-1</field>
            <field name="type">sum</field>
            <field name="cumulative" eval="False"/>
        </record>
        <record id="account_financial_report_income0" model="account.financial.report">
            <field name="name">Income</field>
            <field name="sign">-1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="account_financial_report_profitandloss0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">sum</field>
        </record>
        <record id="financial_report_gross_profit" model="account.financial.report">
            <field name="name">Gross Profit</field>
            <field name="sign">-1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="account_financial_report_income0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">sum</field>
        </record>
        <record id="account_financial_report_operating_income0" model="account.financial.report">
            <field name="name">Operating Income</field>
            <field name="sign">-1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="financial_report_gross_profit"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">income</field>
        </record>
        <!-- shown negative under Gross Profit: Operating Income + Cost of Revenue = Gross Profit -->
        <record id="financial_report_cost_of_revenue" model="account.financial.report">
            <field name="name">Cost of Revenue</field>
            <field name="sign">-1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="financial_report_gross_profit"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">expense_direct_cost</field>
        </record>
        <record id="account_financial_report_other_income0" model="account.financial.report">
            <field name="name">Other Income</field>
            <field name="sign">-1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="account_financial_report_income0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">income_other</field>
        </record>
        <record id="account_financial_report_expense0" model="account.financial.report">
            <field name="name">Expenses</field>
            <field name="sign">1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="account_financial_report_profitandloss0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">sum</field>
            <field name="account_type_ids" eval="False"/>
        </record>
        <record id="financial_report_operating_expenses" model="account.financial.report">
            <field name="name">Operating Expenses</field>
            <field name="sign">1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="account_financial_report_expense0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">expense</field>
        </record>
        <record id="financial_report_depreciation" model="account.financial.report">
            <field name="name">Depreciation</field>
            <field name="sign">1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="account_financial_report_expense0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">expense_depreciation</field>
        </record>

        <!-- ================= Balance Sheet ================= -->
        <!-- cumulative: balances at the end date, whatever the start date -->
        <record id="account_financial_report_balancesheet0" model="account.financial.report">
            <field name="name">Balance Sheet</field>
            <field name="sign">1</field>
            <field name="type">sum</field>
            <field name="cumulative" eval="True"/>
        </record>

        <record id="account_financial_report_assets0" model="account.financial.report">
            <field name="name">Assets</field>
            <field name="sign">1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="account_financial_report_balancesheet0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">sum</field>
            <field name="account_type_ids" eval="False"/>
        </record>
        <record id="financial_report_bank_cash" model="account.financial.report">
            <field name="name">Bank and Cash</field>
            <field name="sign">1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="account_financial_report_assets0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">asset_cash</field>
        </record>
        <record id="financial_report_receivable" model="account.financial.report">
            <field name="name">Receivables</field>
            <field name="sign">1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="account_financial_report_assets0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">asset_receivable</field>
        </record>
        <record id="financial_report_current_assets" model="account.financial.report">
            <field name="name">Current Assets</field>
            <field name="sign">1</field>
            <field name="sequence">3</field>
            <field name="parent_id" ref="account_financial_report_assets0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">asset_current</field>
        </record>
        <record id="financial_report_prepayments" model="account.financial.report">
            <field name="name">Prepayments</field>
            <field name="sign">1</field>
            <field name="sequence">4</field>
            <field name="parent_id" ref="account_financial_report_assets0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">asset_prepayments</field>
        </record>
        <record id="financial_report_non_current_assets" model="account.financial.report">
            <field name="name">Non-current Assets</field>
            <field name="sign">1</field>
            <field name="sequence">5</field>
            <field name="parent_id" ref="account_financial_report_assets0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">asset_non_current</field>
        </record>
        <record id="financial_report_fixed_assets" model="account.financial.report">
            <field name="name">Fixed Assets</field>
            <field name="sign">1</field>
            <field name="sequence">6</field>
            <field name="parent_id" ref="account_financial_report_assets0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">asset_fixed</field>
        </record>

        <record id="account_financial_report_liabilitysum0" model="account.financial.report">
            <field name="name">Liabilities</field>
            <field name="sign">-1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="account_financial_report_balancesheet0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">sum</field>
        </record>
        <record id="account_financial_report_liability0" model="account.financial.report">
            <field name="name">Payables</field>
            <field name="sign">-1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="account_financial_report_liabilitysum0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">liability_payable</field>
        </record>
        <record id="financial_report_credit_card" model="account.financial.report">
            <field name="name">Credit Card</field>
            <field name="sign">-1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="account_financial_report_liabilitysum0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">liability_credit_card</field>
        </record>
        <record id="financial_report_current_liabilities" model="account.financial.report">
            <field name="name">Current Liabilities</field>
            <field name="sign">-1</field>
            <field name="sequence">3</field>
            <field name="parent_id" ref="account_financial_report_liabilitysum0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">liability_current</field>
        </record>
        <record id="financial_report_non_current_liabilities" model="account.financial.report">
            <field name="name">Non-current Liabilities</field>
            <field name="sign">-1</field>
            <field name="sequence">4</field>
            <field name="parent_id" ref="account_financial_report_liabilitysum0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">liability_non_current</field>
        </record>

        <record id="financial_report_equity_sum" model="account.financial.report">
            <field name="name">Equity</field>
            <field name="sign">-1</field>
            <field name="sequence">3</field>
            <field name="parent_id" ref="account_financial_report_balancesheet0"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">sum</field>
        </record>
        <record id="financial_report_equity" model="account.financial.report">
            <field name="name">Capital and Equity</field>
            <field name="sign">-1</field>
            <field name="sequence">1</field>
            <field name="parent_id" ref="financial_report_equity_sum"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">equity</field>
        </record>
        <record id="financial_report_retained_earnings" model="account.financial.report">
            <field name="name">Retained Earnings</field>
            <field name="sign">-1</field>
            <field name="sequence">2</field>
            <field name="parent_id" ref="financial_report_equity_sum"/>
            <field name="display_detail">detail_with_hierarchy</field>
            <field name="type">account_type</field>
            <field name="account_type_ids">equity_unaffected</field>
        </record>
        <!-- all profit or loss up to the end date not yet closed into equity -->
        <record id="account_financial_report_profitloss_toreport0" model="account.financial.report">
            <field name="name">Profit (Loss) to report</field>
            <field name="sign">-1</field>
            <field name="sequence">3</field>
            <field name="parent_id" ref="financial_report_equity_sum"/>
            <field name="display_detail">no_detail</field>
            <field name="type">account_report</field>
            <field name="account_report_id" ref="account_financial_report_profitandloss0"/>
        </record>
    </data>

    <data noupdate="0">
        <!--    Common Report (a view: kept up to date by upgrades)    -->
        <record id="account_report_view_form" model="ir.ui.view">
            <field name="name">account.report.view.form</field>
            <field name="model">account.report</field>
            <field name="arch" type="xml">
                <form string="Report Options">
                    <group col="4">
                        <field name="target_move" widget="radio"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="journal_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <footer>
                        <button name="check_report" string="View"
                                type="object" default_focus="1"
                                class="oe_highlight"
                                context="{'report_view_html': True}"
                                data-hotkey="v"/>
                        <button name="check_report" string="Print"
                                type="object" class="btn-secondary"
                                data-hotkey="q"/>
                        <button string="Cancel" class="btn btn-secondary"
                                special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
